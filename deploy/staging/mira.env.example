# Mira owner-controlled staging environment.
# Copy to /home/mira-staging/.config/mira-staging/mira.env on the staging host,
# replace every required placeholder outside source control, and chmod 600.

MIRA_NODE_ENV=production
MIRA_LANG=en-US
MIRA_HOST=http://127.0.0.1
MIRA_PORT=1337
MIRA_ROUTING_MODE=agent

# Keep the first staging connection lightweight and deterministic.
MIRA_LLM=false
MIRA_LLM_NLG=false
MIRA_LLM_ACTION_RECOGNITION=false
MIRA_STT=false
MIRA_TTS=false
MIRA_WAKE_WORD=false
MIRA_TELEMETRY=false

MIRA_OVER_HTTP=true
MIRA_HTTP_API_LANG=en-US
MIRA_HTTP_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

MIRA_GREENFIELD_ENABLED=true
MIRA_GREENFIELD_OWNER_ID=REPLACE_WITH_OWNER_ID
MIRA_GREENFIELD_PAIRED_DEVICE_ID=REPLACE_WITH_PAIRED_DEVICE_ID
MIRA_GREENFIELD_PRIVACY_ZONES=private

# Initial staging permissions intentionally exclude trace.purge and memory.purge.
MIRA_GREENFIELD_PERMISSIONS=system.status.read,trace.operations.read,trace.rotation.plan,memory.candidate.create,memory.confirm,memory.read,memory.export

MIRA_GREENFIELD_TRACE_PERSISTENCE=true
MIRA_GREENFIELD_TRACE_OPERATIONS=true
MIRA_GREENFIELD_TRACE_DB_PATH=/home/mira-staging/mira-state/greenfield/traces.sqlite
MIRA_GREENFIELD_TRACE_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
MIRA_GREENFIELD_TRACE_KEY_VERSION=v1
MIRA_GREENFIELD_OWNER_LOOKUP_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_KEY
MIRA_GREENFIELD_TRACE_KEYRING_JSON={"v1":"REPLACE_WITH_THE_SAME_TRACE_MASTER_KEY"}
MIRA_GREENFIELD_TRACE_BACKUP_PATH=/home/mira-staging/mira-state/backups/traces.sqlite
MIRA_GREENFIELD_TRACE_RETENTION_DAYS=30
MIRA_GREENFIELD_TRACE_MAINTENANCE_INTERVAL_MINUTES=60
MIRA_GREENFIELD_TRACE_MAINTENANCE_ON_STARTUP=true
MIRA_GREENFIELD_TRACE_OPERATION_TTL_SECONDS=300
MIRA_GREENFIELD_TRACE_ROTATION_PLAN_TTL_SECONDS=900
MIRA_GREENFIELD_TRACE_ROTATION_SPACE_MULTIPLIER=2.2

MIRA_GREENFIELD_MEMORY=true
MIRA_GREENFIELD_MEMORY_DB_PATH=/home/mira-staging/mira-state/greenfield/memory.sqlite
MIRA_GREENFIELD_MEMORY_MASTER_KEY=REPLACE_WITH_THIRD_BASE64_32_BYTE_KEY
MIRA_GREENFIELD_MEMORY_KEY_VERSION=v1
MIRA_GREENFIELD_MEMORY_CANDIDATE_TTL_SECONDS=900
MIRA_GREENFIELD_MEMORY_PURGE_PLAN_TTL_SECONDS=300

# Deployment-only values consumed by staging scripts, not the Mira runtime.
MIRA_STAGING_BASE_URL=http://127.0.0.1:1337
MIRA_STAGING_ALLOW_DESTRUCTIVE=false
