{
  "name": "@mira-ai/aurora",
  "version": "1.0.0",
  "description": "Mira's UI component library",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "prepare": "tsc --project tsconfig.json && cp src/style.css dist/style.css",
    "build": "tsc --project tsconfig.json && cp src/style.css dist/style.css",
    "dev": "tsc --watch --project tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7"
  }
}
