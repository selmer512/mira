# Main settings of Mira
# https://docs.getleon.ai/configuration

# Language currently used
MIRA_LANG=en-US

# Server
MIRA_HOST=http://localhost
MIRA_PORT=1337

# Routing mode: smart | workflow | agent
MIRA_ROUTING_MODE=smart
# Comma-separated context files to disable (e.g. BROWSER_HISTORY.md,ACTIVITY.md)
MIRA_DISABLED_CONTEXT_FILES=
# Memory system

# Enable/disable LLM
MIRA_LLM=true
# Default LLM provider fallback for all duties
# Supported values: llamacpp | sglang | openrouter | zai | openai | anthropic | moonshotai | huggingface | cerebras | groq
MIRA_LLM_PROVIDER=llamacpp
# Workflow/provider split:
# - if both workflow and agent use a local provider, they must use the same provider and model
# - use llama.cpp to let Mira spawn its own local llama-server
# - optionally use SGLang on Linux for higher-performance local serving
MIRA_WORKFLOW_LLM_PROVIDER=llamacpp
MIRA_AGENT_LLM_PROVIDER=llamacpp

# llama.cpp local LLM (served by Mira via bin/llama.cpp/llama-server)
# Keep the model file under core/data/models/llm/
# Leave empty to use the default model installed by Mira.
MIRA_LLAMACPP_MODEL_PATH=
# GPU layers to offload (99 = all layers on GPU, 0 = CPU-only)
MIRA_LLAMACPP_GPU_LAYERS=99

# Optional Linux high-performance local provider (OpenAI-compatible)
MIRA_SGLANG_BASE_URL=http://127.0.0.1:30000/v1
MIRA_SGLANG_API_KEY=
MIRA_SGLANG_MODEL=Qwen/Qwen3-Coder-Next
MIRA_SGLANG_AGENT_LLM=Qwen/Qwen3-Coder-Next

# OpenRouter API key
MIRA_OPENROUTER_API_KEY=
# OpenRouter agent LLM - https://openrouter.ai/models
MIRA_OPENROUTER_AGENT_LLM=z-ai/glm-5-turbo
# MIRA_OPENROUTER_AGENT_LLM=moonshotai/kimi-k2.5
# MIRA_OPENROUTER_AGENT_LLM=openai/gpt-5.2
# MIRA_OPENROUTER_AGENT_LLM=openai/gpt-5-mini
# MIRA_OPENROUTER_AGENT_LLM=qwen/qwen3.5-35b-a3b
# MIRA_OPENROUTER_AGENT_LLM=qwen/qwen3.5-122b-a10b
# MIRA_OPENROUTER_AGENT_LLM=anthropic/claude-opus-4.6
# MIRA_OPENROUTER_AGENT_LLM=minimax/minimax-m2.5
# MIRA_OPENROUTER_AGENT_LLM=qwen/qwen3.5-flash-02-23
# MIRA_OPENROUTER_AGENT_LLM=qwen/qwen3-coder-next
# MIRA_OPENROUTER_AGENT_LLM=xiaomi/mimo-v2-flash
# MIRA_OPENROUTER_AGENT_LLM=qwen/qwen3-235b-a22b-2507
# MIRA_OPENROUTER_AGENT_LLM=openai/gpt-oss-120b

# Z.AI API key
MIRA_ZAI_API_KEY=
# Z.AI agent LLM
MIRA_ZAI_AGENT_LLM=glm-5

# OpenAI API key
MIRA_OPENAI_API_KEY=
# OpenAI agent LLM - https://developers.openai.com/api/docs/guides/latest-model
MIRA_OPENAI_AGENT_LLM=gpt-5.4
# MIRA_OPENAI_AGENT_LLM=gpt-5.4-mini

# Anthropic API key
MIRA_ANTHROPIC_API_KEY=
# Anthropic agent LLM
MIRA_ANTHROPIC_AGENT_LLM=claude-opus-4-6
# MIRA_ANTHROPIC_AGENT_LLM=claude-haiku-4-5

# Moonshot AI API key
MIRA_MOONSHOTAI_API_KEY=
# Moonshot AI agent LLM
MIRA_MOONSHOTAI_AGENT_LLM=kimi-k2.5

# HuggingFace API key
MIRA_HUGGINGFACE_API_KEY=
# HuggingFace agent LLM
MIRA_HUGGINGFACE_AGENT_LLM=meta-llama/Meta-Llama-3.1-8B-Instruct

# Cerebras API key
MIRA_CEREBRAS_API_KEY=
# Cerebras agent LLM
MIRA_CEREBRAS_AGENT_LLM=gpt-oss-120b

# Groq API key
MIRA_GROQ_API_KEY=
# Groq agent LLM
MIRA_GROQ_AGENT_LLM=llama-3.1-8b-instant

# Enable/disable Mira's wake word
MIRA_WAKE_WORD=true

# Enable/disable Mira's speech-to-text
MIRA_STT=true
# Speech-to-text provider
MIRA_STT_PROVIDER=local

# Enable/disable Mira's text-to-speech
MIRA_TTS=true
# Text-to-speech provider
MIRA_TTS_PROVIDER=local

# Enable/disable LLM natural language generation
MIRA_LLM_NLG=false
# Enable/disable LLM Action Recognition
# Can fallback to chit-chat if no action is recognized
MIRA_LLM_ACTION_RECOGNITION=false

# Time zone (current one by default)
MIRA_TIME_ZONE=

# Enable/disable after speech
MIRA_AFTER_SPEECH=false

# Enable/disable skills to be available over HTTP
MIRA_OVER_HTTP=true
# HTTP API key (use "npm run generate:http-api-key" to regenerate one)
MIRA_HTTP_API_KEY=
# Language used for the HTTP API
MIRA_HTTP_API_LANG=en-US

# Enable/disable telemetry
MIRA_TELEMETRY=true

# Python TCP server
MIRA_PY_TCP_SERVER_HOST=0.0.0.0
MIRA_PY_TCP_SERVER_PORT=1342

# Path to the Pipfile
PIPENV_PIPFILE=tcp_server/src/Pipfile

# Path to the virtual env in .venv/
PIPENV_VENV_IN_PROJECT=true
